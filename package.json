{
  "name": "llguidance",
  "version": "0.1.7",
  "description": "Browser and Node.js TypeScript implementation of llguidance constrained decoding.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "llguidance",
    "typescript",
    "grammar",
    "json-schema",
    "constrained-decoding"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:js": "node scripts/build-js.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "dev": "node scripts/build-js.mjs --watch",
    "bench:mask": "node scripts/benchmark-mask.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "prettier": "^3.9.4"
  }
}
