{
  "name": "llguidance",
  "version": "0.1.1",
  "description": "Browser and Node.js WASM bindings for llguidance constrained decoding.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "llguidance",
    "wasm",
    "grammar",
    "json-schema",
    "constrained-decoding"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:llguidance-wasm": "node scripts/build-llguidance-wasm.mjs --release",
    "build:llguidance-wasm:dev": "node scripts/build-llguidance-wasm.mjs --dev",
    "build:js": "node scripts/build-js.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "test": "node --test",
    "publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "prettier": "^3.9.4"
  }
}
