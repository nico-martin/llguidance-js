{
  "name": "llguidance",
  "version": "0.2.0",
  "description": "Browser and Node.js TypeScript implementation of llguidance constrained decoding.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "llguidance",
    "typescript",
    "grammar",
    "json-schema",
    "constrained-decoding"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:js": "node scripts/build-js.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "dev": "node scripts/build-js.mjs --watch",
    "bench:mask": "node scripts/benchmark-mask.mjs",
    "bench:grammar": "node scripts/benchmark-grammar-mask.mjs",
    "compare:browser:build": "node scripts/build-comparison-demo.mjs",
    "compare:browser": "node scripts/serve-comparison-demo.mjs",
    "size:js": "node scripts/report-bundle-sizes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:schema-suite": "node scripts/run-json-schema-suite.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "llguidance-wasm": "npm:llguidance@0.1.7",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "prettier": "^3.9.4"
  }
}
